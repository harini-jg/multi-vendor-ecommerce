Table users {
  id int [pk]
  name varchar
  email varchar
  password varchar
  role varchar
}

Table vendors {
  id int [pk]
  user_id int
  store_name varchar
}

Table categories {
  id int [pk]
  name varchar
}

Table products {
  id int [pk]
  vendor_id int
  category_id int
  name varchar
  price decimal
  stock int
}

Table orders {
  id int [pk]
  user_id int
  total decimal
  status varchar
}

Table order_items {
  id int [pk]
  order_id int
  product_id int
  quantity int
}

Table payments {
  id int [pk]
  order_id int
  status varchar
}

Ref: vendors.user_id > users.id
Ref: products.vendor_id > vendors.id
Ref: products.category_id > categories.id
Ref: orders.user_id > users.id
Ref: order_items.order_id > orders.id
Ref: order_items.product_id > products.id
Ref: payments.order_id - orders.id
